# Optional legacy key (used after numbered keys; dashboard/PDF tools do not need a key).
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-3.8-flash

# Optional: maximum document text sent to Gemini (characters, default 40000).
STUDY_ASSISTANT_MAX_CONTEXT_CHARS=40000

# Local semantic retrieval (the model downloads when indexing/search is first used).
STUDY_ASSISTANT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
STUDY_ASSISTANT_INDEX_DIR=
STUDY_ASSISTANT_CHUNK_SIZE_CHARS=1200
STUDY_ASSISTANT_CHUNK_OVERLAP_CHARS=200
STUDY_ASSISTANT_RETRIEVAL_TOP_K=5

# Local OCR only; install the Tesseract executable separately on Windows.
STUDY_ASSISTANT_TESSERACT_CMD=
STUDY_ASSISTANT_OCR_LANG=eng
STUDY_ASSISTANT_OCR_DPI=275
STUDY_ASSISTANT_OCR_MIN_NATIVE_CHARS=30
